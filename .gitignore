# Build outputs: generated from data/*.geojson by scripts/build-tiles.py, and by
# the deploy workflow. Committing them would cost ~7 MB of history per update,
# against ~144 kB for the GeoJSON they come from.
data/*.pmtiles

# Original research data stays local. The Alps-wide TIFFs are hundreds of MB
# and the shapefile is source material for a later web-tiling pipeline.
original-data/
derived-data/
# The built PMTiles archives. They are published as GitHub Release assets and
# copied into the Pages site by .github/workflows/pages.yml — see DEPLOYMENT.md.
local-data/

# The GLACE raster archives, mounted by scripts/serve.py at ./tiles. No trailing
# slash: this is usually a symlink to a local build, and git sees a symlink as a
# file, so `tiles/` would not match it.
tiles
_site/

# Dev-only: the page loads js/ directly and has no runtime dependencies.
# `.pixi/` is the environment pixi.lock describes; `node_modules/` is jsdom for
# `npm test` and nothing else.
.pixi/
node_modules/

__pycache__/
.DS_Store

# Windows download metadata is not project data.
*:Zone.Identifier

.dmypy*.json

# Private project notes and working docs, not for the public repository.
NOTES.md
TASKS.md
DEPLOYMENT.md
DEM_WORKFLOW.md
AGENTS.md
.vscode/
